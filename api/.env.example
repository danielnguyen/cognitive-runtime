# Local host-run template for `make dev-start` from the repo root.
# Default local storage is `./data/companion_contracts.sqlite3` from the API working directory.
# Set this explicitly to override the SQLite location.
COMPANION_CONTRACTS_DB_PATH=./data/companion_contracts.sqlite3

# Optional bounded trusted-verifier registry for runtime world-state verification.
# The example file is not loaded unless this path is set explicitly.
TRUSTED_WORLD_STATE_VERIFIERS_PATH=
